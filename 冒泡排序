#include<iostream>
#include<algorithm>
using namespace std;

int main() {
	int a[] = { 8,3,6,2,7,1 };
	int n = 6;
	for (int i = 0;i < n - 1;i = i + 1)
		for (int j = 0;j < n - 1 - i;j = j + 1)
			if (a[j] > a[j + 1])
				swap(a[j], a[j + 1]);
	for (int i = 0;i < n;i = i + 1)
		cout << a[i] << ' ';
	cout << endl;
	return 0;
}
